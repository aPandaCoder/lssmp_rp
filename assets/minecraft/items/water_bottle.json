    "component": "minecraft:custom_name",
    "cases": [
      {
        "when": "Cola",
        "model": {
          "type": "minecraft:model",
          "model": "lssmp:item/cola"
        }
      },
      {
        "when": "Fanta",
        "model": {
          "type": "minecraft:model",
          "model": "lssmp_rp:item/fanta"
        }
      },
      {
        "when": "Ice Tea",
        "model": {
          "type": "minecraft:model",
          "model": "lssmp:item/ice_tea"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "minecraft:item/water_bottle"
    }
  }
}